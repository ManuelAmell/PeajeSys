# ==========================================
# PeajeSys - .gitignore
# ==========================================

# --- .NET / C# ---
[Bb]in/
[Oo]bj/
*.user
*.dll
*.exe
*.pdb
*.userosscache
*.userprefs
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rms/
[Aa]rm64/
bld/
[Ll]og/
[Ll]ogs/
appsettings.Development.json
appsettings.Local.json

# --- Visual Studio ---
.vs/
*.rsuser
*.suo
*.ide
*.ntvs*
*.njsproj
*.sln.docstates

# --- Visual Studio Code ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --- Node / TypeScript / Frontend ---
node_modules/
dist/
build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env
.env.local
.env.*.local
*.tsbuildinfo

# --- PostgreSQL & Database ---
*.sql.bak
*.dump
*.backup
*.log
database/backups/
!database/backups/.gitkeep

# --- OS Specific ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

temp_appdata/
