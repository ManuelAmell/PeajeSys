# Archivo OPCIONAL: ya no hace falta crear .env para arrancar.
# Los modos de Vite versionados (.env.development para `pnpm dev` y
# .env.mocks para `pnpm dev:mocks`) traen los valores por defecto.
# Un .env o .env.local propio (no versionado) sobrescribe esos valores.
# Variable opcional: VITE_API_PROXY_TARGET (destino del proxy, por defecto http://localhost:5080).
VITE_API_BASE_URL=/api
VITE_USAR_MOCKS=true
